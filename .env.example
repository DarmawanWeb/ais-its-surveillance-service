# ais-its-surveillance-service — every variable the service reads (docs/PLATFORM_SPEC.md §4, §13.8).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=surveillance
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3007
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000
# Proxies whose X-Forwarded-* headers are trusted (default: loopback and private networks).
# TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# --- PostgreSQL (TimescaleDB + PostGIS), schema "surveillance" ---------------------
DATABASE_URL=postgres://surveillance_svc:surveillance_svc@localhost:5432/aisits
DATABASE_SCHEMA=surveillance
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed.
NATS_URL=nats://localhost:4222
# Prefix of the durable consumer names (isolates test runs or parallel environments).
# NATS_DURABLE_PREFIX=

# --- Valkey ------------------------------------------------------------------------
# Part of the platform base schema; this service does not import RedisModule (no Valkey use).
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (no route of this service accepts API keys).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# --- Tracing (OTLP/HTTP; disabled when unset) --------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Detector runner (src/config.ts) ---------------------------------------------------
# Positions handled in parallel (one vessel's positions stay ordered), 1–64.
DETECTOR_CONCURRENCY=8
# SDK alert cool-down: minimum time between two publications of one dedupKey, minutes (0–1440).
ALERT_COOLDOWN_MIN=10
# Minimum event-time interval between two vessel_state writes of a vessel, seconds
# (transhipment candidates are written on every position).
VESSEL_STATE_WRITE_INTERVAL_S=60

# --- Detectors (Detector SDK, spec §18; validated per detector, prefix removed) -------
# Comma separated subset of transhipment,anomaly,dark,geofence,fishing; default: all.
# A subset consumes through its own durable (surveillance-positions-<sorted ids>).
# DETECTORS=transhipment,anomaly,dark,geofence,fishing
# Lists accept the value "none" for "no entries" (a blank variable means "default").

# transhipment — legacy illegal-transhipment parity (candidate queue + interpolation analysis).
# Candidates: vessels from these AIS sources (legacy isBatam) …
TRANSHIPMENT_SOURCES=batam
# … or inside active zones of these kinds (none = sources only).
TRANSHIPMENT_ZONE_KINDS=transhipment_area
# Neighbour search radius, metres (location priority is 0 beyond 600 m).
TRANSHIPMENT_NEIGHBOUR_RADIUS_M=600
# Neighbours must have been seen within this window, minutes (legacy 5; 1–30).
TRANSHIPMENT_NEIGHBOUR_WINDOW_MIN=5
# Accumulated priority a pair needs to be analysed (legacy: every queued pair).
TRANSHIPMENT_MIN_PRIORITY=1
# Interval of the scheduled analyser, seconds; pairs claimed per run (FOR UPDATE SKIP LOCKED).
TRANSHIPMENT_ANALYSIS_INTERVAL_S=30
TRANSHIPMENT_ANALYSIS_BATCH=10
# A pair analysed less than this ago stays queued, minutes (legacy 15).
TRANSHIPMENT_REANALYSIS_COOLDOWN_MIN=15
# Track window and fixes per vessel of the analysis (legacy 60 min, last 60 fixes).
TRANSHIPMENT_ROUTE_WINDOW_MIN=60
TRANSHIPMENT_ROUTE_MAX_POINTS=60
# Sliding-window length, minutes (legacy checkDuration 30) and score threshold, percent (legacy 70).
TRANSHIPMENT_CHECK_DURATION_MIN=30
TRANSHIPMENT_ACCURACY_THRESHOLD=70
# Score from which an event is critical (else warning), percent.
TRANSHIPMENT_CRITICAL_ACCURACY=90
# An open occurrence is resolved when the pair was not observed together for this long, minutes.
TRANSHIPMENT_PAIR_EXPIRY_MIN=60
# Claims older than this go back to the queue (crashed analyser), minutes.
TRANSHIPMENT_CLAIM_TIMEOUT_MIN=5

# anomaly — navstatus anomaly (legacy web app rule, server-side).
# Consecutive mismatching positions before an event.
ANOMALY_MIN_POSITIONS=3
# Reported navstatus codes that never count (none = legacy parity; e.g. 15 for Class B units).
ANOMALY_EXCLUDED_NAVSTATUS=none

# dark — AIS gap.
# Silence after which a moving vessel is dark, minutes.
DARK_GAP_MIN=30
# Last speed over ground must exceed this, knots.
DARK_MIN_SOG_KN=1
# Last position must be farther than this from a harbour zone, kilometres.
DARK_HARBOUR_DISTANCE_KM=5
DARK_HARBOUR_ZONE_KINDS=port,anchorage
# Vessels silent for longer than this are no longer reported (stale states), hours.
DARK_MAX_GAP_H=24
# Scan interval, seconds, and vessels examined per scan.
DARK_CHECK_INTERVAL_S=60
DARK_SCAN_LIMIT=5000

# geofence — zone entry.
GEOFENCE_KINDS=restricted,mpa,custom
# Kinds whose entry is critical (others: warning; none = all warning).
GEOFENCE_CRITICAL_KINDS=restricted
# Count the zone's bufferM as inside (true|false).
GEOFENCE_USE_BUFFER=true

# fishing — loitering pattern inside fishing zones.
FISHING_ZONE_KINDS=fishing_ground,restricted
# Kinds where the event is critical (others: warning; none = all warning).
FISHING_CRITICAL_KINDS=restricted
# Speed band, knots.
FISHING_MIN_SOG_KN=0.5
FISHING_MAX_SOG_KN=4
# Minimum duration (minutes) and fixes of the pattern; largest gap between two fixes, minutes.
FISHING_MIN_DURATION_MIN=30
FISHING_MIN_POSITIONS=6
FISHING_MAX_GAP_MIN=10
# Course changes are measured between fixes at least this far apart, minutes, and must average
# at least this rate, degrees per minute.
FISHING_SAMPLE_MIN=3
FISHING_MIN_COURSE_CHANGE_DEG_PER_MIN=3
# Evaluation window (recent part of the run), minutes; resolve after this long without a
# qualifying fix, minutes.
FISHING_WINDOW_MIN=60
FISHING_RESOLVE_AFTER_MIN=30
