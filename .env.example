# ais-its-surveillance-service — every variable the service reads (docs/PLATFORM_SPEC.md §4).
# Copy to .env for local development; real secrets never go into the repository.

# --- Service -------------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=surveillance
# Defaults to the package.json version.
# SERVICE_VERSION=0.1.0
HOST=0.0.0.0
PORT=3007
LOG_LEVEL=info
# Pretty logs need the dev dependency pino-pretty; defaults to true in development.
LOG_PRETTY=true
# Graceful shutdown deadline (SIGTERM → readiness 503 → drain → exit).
SHUTDOWN_TIMEOUT_MS=30000

# --- PostgreSQL (TimescaleDB + PostGIS), schema "surveillance" ---------------------
DATABASE_URL=postgres://surveillance_svc:surveillance_svc@localhost:5432/aisits
DATABASE_SCHEMA=surveillance
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Apply migrations/ at startup (also `pnpm migrate`).
DB_MIGRATE_ON_BOOT=true

# --- NATS JetStream --------------------------------------------------------------
# Comma separated list allowed.
NATS_URL=nats://localhost:4222

# --- Valkey (only read when RedisModule is imported) -----------------------------
REDIS_URL=redis://localhost:6379

# --- Authentication (spec §8) ----------------------------------------------------
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
AUTH_ISSUER=ais-its-auth
AUTH_AUDIENCE=ais-its-api
# API-key introspection (routes marked @AllowApiKey).
AUTH_INTERNAL_URL=http://localhost:3001
# X-Internal-Token for /internal/* — at least 16 characters and not this value in production.
INTERNAL_TOKEN=dev-internal-token-change-me

# --- HTTP ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# --- Tracing (OTLP/HTTP; disabled when unset) --------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Detectors (Detector SDK, spec §18) ---------------------------------------------
# Comma separated detector ids to run in this instance; default: all registered.
DETECTORS=speed_limit
# speed_limit: alert while a vessel is faster than SPEED_LIMIT_MAX_SOG_KN inside a zone of
# SPEED_LIMIT_ZONE_KINDS; critical above SPEED_LIMIT_MAX_SOG_KN × SPEED_LIMIT_CRITICAL_FACTOR;
# resolved once it is SPEED_LIMIT_RESOLVE_MARGIN_KN below the limit or leaves the zone.
SPEED_LIMIT_MAX_SOG_KN=8
SPEED_LIMIT_CRITICAL_FACTOR=1.5
SPEED_LIMIT_RESOLVE_MARGIN_KN=0.5
SPEED_LIMIT_ZONE_KINDS=port,anchorage,tss_lane
